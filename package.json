{
  "name": "cold-smoke",
  "version": "1.0.0",
  "description": "雪迹 Cold Smoke: an endless, chill downhill ski game in one HTML file. Every picture and sound is made by code.",
  "license": "MIT",
  "private": true,
  "homepage": "https://github.com/lzcjames/cold-smoke-reality",
  "repository": {
    "type": "git",
    "url": "https://github.com/lzcjames/cold-smoke-reality.git"
  },
  "scripts": {
    "build": "node build.js",
    "test": "node --test test/*.test.cjs",
    "test:browser": "node test/browser.mjs",
    "check": "node tools/check-native.js",
    "motion": "node tools/motion/run.js",
    "start": "node build.js && node tools/serve.js",
    "build:xhs": "node tools/build-xhs.js",
    "resort:import": "node tools/reality/import_portable_resort.cjs",
    "resort:osm-import": "node tools/reality/import_osm_survey.cjs"
  },
  "engines": {
    "node": ">=18"
  }
}
